# Neon pooled connection for runtime queries
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/ecotrading?sslmode=require&pgbouncer=true&connection_limit=1

# Neon direct connection for migrations and seeds
DIRECT_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/ecotrading?sslmode=require

NODE_ENV=development
PORT=5000

JWT_SECRET=replace_with_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=1

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_random_password

PRICE_SOURCE=none
