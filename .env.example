# Frontend (Vite) environment. Copy to .env in the project root.
# Backend configuration lives in server/.env.example — see that file for
# DATABASE_URL, JWT_SECRET, ADMIN_EMAIL, RUN_JOBS, P2P_AUTO_RELEASE, etc.

# Base URL of the API, used by axios/fetch calls from the browser.
VITE_API_BASE=http://localhost:5000

# Base URL of the Socket.IO server.
VITE_WS_BASE=http://localhost:5000

# Optional: dev server bind address (defaults to localhost).
# VITE_DEV_HOST=localhost
