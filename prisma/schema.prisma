generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Side {
  buy
  sell
}

enum TradeSource {
  user
  bot
}

enum OrderType {
  market
  limit
}

enum OrderStatus {
  open
  partial
  filled
  canceled
}

model User {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  email              String   @unique
  password           String
  // GULU only enters circulation through admin issuance or P2P purchase
  balance            Float    @default(0)
  // GULU held in escrow for open P2P orders; kept apart from spendable balance
  locked             Float    @default(0)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  portfolio          Json     @default("{}")
  watchlist          Json     @default("[]")
  priceAlerts        Json     @default("[]")
  tradingBots        Json     @default("[]")
  competitions       Json     @default("[]")
  socialTrading      Json     @default("{}")
  apiKeys            Json     @default("[]")
  lastLogin          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trades       Trade[]
  transactions Transaction[]
  orders       Order[]
  merchant     Merchant?
  p2pBuys      P2POrder[] @relation("P2PBuyer")
  p2pSells     P2POrder[] @relation("P2PSeller")
  guluIssues   GuluIssue[]

  @@index([isActive])
}

enum MerchantStatus {
  pending
  approved
  rejected
  suspended
}

enum GuluOpType {
  mint
  burn
}

// Every supply change is recorded here; total supply is sum(mint) - sum(burn)
model GuluIssue {
  id       String     @id @default(cuid())
  type     GuluOpType
  amount   Float
  userId   String?
  operator String
  note     String?
  ts       BigInt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ts])
}

enum P2PSide {
  buy
  sell
}

enum P2POrderStatus {
  pending_payment
  paid
  completed
  cancelled
  disputed
}

// Merchant is a user allowed to publish P2P ads; bots are merchants with auto release
model Merchant {
  id              String         @id @default(cuid())
  userId          String         @unique
  businessName    String
  contact         String?
  status          MerchantStatus @default(pending)
  isBot           Boolean        @default(false)
  note            String?
  maxOrderGulu    Float          @default(1000)
  dailyLimitGulu  Float          @default(5000)
  completedOrders Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ads  P2PAd[]

  @@index([status])
}

model P2PAd {
  id             String   @id @default(cuid())
  merchantId     String
  // side is the merchant's side: sell means the merchant sells GULU to users
  side           P2PSide
  price          Float
  fiat           String   @default("CNY")
  minAmount      Float    @default(10)
  maxAmount      Float    @default(10000)
  available      Float    @default(0)
  paymentMethods Json     @default("[]")
  terms          String?
  status         String   @default("active")
  autoRelease    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchant Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders   P2POrder[]

  @@index([status, side])
  @@index([merchantId])
}

model P2POrder {
  id            String         @id @default(cuid())
  adId          String
  buyerId       String
  sellerId      String
  amount        Float
  price         Float
  fiatAmount    Float
  fiat          String         @default("CNY")
  status        P2POrderStatus @default(pending_payment)
  paymentMethod String?
  paymentRef    String?
  cancelReason  String?
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  completedAt   DateTime?

  ad     P2PAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  buyer  User  @relation("P2PBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller User  @relation("P2PSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, paidAt])
}

model Admin {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  firstName          String   @default("")
  lastName           String   @default("")
  role               String   @default("admin")
  isActive           Boolean  @default(true)
  permissions        String[] @default([])
  mustChangePassword Boolean  @default(true)
  lastLogin          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MarketData {
  symbol      String    @id
  name        String
  price       Float     @default(0)
  manualPrice Float?
  autoSync    Boolean   @default(true)
  volatility  Float     @default(1.0)
  decimals    Int       @default(2)
  open24h     Float     @default(0)
  change24h   Float     @default(0)
  volume24h   Float     @default(0)
  delisted    Boolean   @default(false)
  delistedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  trades Trade[]
  orders Order[]

  @@index([delisted])
}

model Trade {
  id      String      @id @default(cuid())
  userId  String?
  symbol  String
  side    Side
  size    Float
  price   Float
  pnl     Float       @default(0)
  source  TradeSource @default(user)
  botName String?
  time    BigInt

  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  coin MarketData @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, time])
  @@index([userId, time])
}

// Resting limit orders. A null userId marks platform liquidity, which is not
// backed by a user balance and therefore never settles user funds.
model Order {
  id        String      @id @default(cuid())
  userId    String?
  symbol    String
  side      Side
  type      OrderType   @default(limit)
  price     Float
  size      Float
  filled    Float       @default(0)
  status    OrderStatus @default(open)
  house     Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  coin MarketData @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, side, status, price])
  @@index([userId, status])
  @@index([house, status])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reason        String?
  operator      String?
  fromUserId    String?
  toUserId      String?
  ts            BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ts])
  @@index([type])
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String?
  author      String?
  category    String?
  source      String?
  imageUrl    String?
  priority    Int      @default(0)
  views       Int      @default(0)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([isPublished, publishedAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String?
  type        String    @default("info")
  priority    String    @default("medium")
  active      Boolean   @default(true)
  targetUsers String    @default("all")
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
