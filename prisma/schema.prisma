generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Side {
  buy
  sell
}

enum TradeSource {
  user
  bot
}

enum OrderType {
  market
  limit
}

enum OrderStatus {
  open
  partial
  filled
  canceled
}

model User {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  email              String   @unique
  password           String
  balance            Float    @default(10000)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  portfolio          Json     @default("{}")
  watchlist          Json     @default("[]")
  priceAlerts        Json     @default("[]")
  tradingBots        Json     @default("[]")
  competitions       Json     @default("[]")
  socialTrading      Json     @default("{}")
  apiKeys            Json     @default("[]")
  lastLogin          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trades       Trade[]
  transactions Transaction[]
  orders       Order[]

  @@index([isActive])
}

model Admin {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  firstName          String   @default("")
  lastName           String   @default("")
  role               String   @default("admin")
  isActive           Boolean  @default(true)
  permissions        String[] @default([])
  mustChangePassword Boolean  @default(true)
  lastLogin          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MarketData {
  symbol      String    @id
  name        String
  price       Float     @default(0)
  manualPrice Float?
  autoSync    Boolean   @default(true)
  volatility  Float     @default(1.0)
  decimals    Int       @default(2)
  open24h     Float     @default(0)
  change24h   Float     @default(0)
  volume24h   Float     @default(0)
  delisted    Boolean   @default(false)
  delistedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  trades Trade[]
  orders Order[]

  @@index([delisted])
}

model Trade {
  id      String      @id @default(cuid())
  userId  String?
  symbol  String
  side    Side
  size    Float
  price   Float
  pnl     Float       @default(0)
  source  TradeSource @default(user)
  botName String?
  time    BigInt

  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  coin MarketData @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, time])
  @@index([userId, time])
}

// Resting limit orders. A null userId marks platform liquidity, which is not
// backed by a user balance and therefore never settles user funds.
model Order {
  id        String      @id @default(cuid())
  userId    String?
  symbol    String
  side      Side
  type      OrderType   @default(limit)
  price     Float
  size      Float
  filled    Float       @default(0)
  status    OrderStatus @default(open)
  house     Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  coin MarketData @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, side, status, price])
  @@index([userId, status])
  @@index([house, status])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reason        String?
  operator      String?
  fromUserId    String?
  toUserId      String?
  ts            BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ts])
  @@index([type])
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String?
  author      String?
  category    String?
  source      String?
  imageUrl    String?
  priority    Int      @default(0)
  views       Int      @default(0)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([isPublished, publishedAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String?
  type        String    @default("info")
  priority    String    @default("medium")
  active      Boolean   @default(true)
  targetUsers String    @default("all")
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
